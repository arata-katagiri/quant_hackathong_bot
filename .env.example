# Use the separate TEST credentials first. Never commit the real .env file.
ROOSTOO_API_KEY=
ROOSTOO_SECRET_KEY=

# Start in observation mode. Set to false only after reviewing dry-run logs.
DRY_RUN=true
PAIRS=BTC/USD,ETH/USD
POLL_SECONDS=300
DATA_DIR=data

# Strategy and safety limits
FAST_WINDOW=12
SLOW_WINDOW=48
MAX_ASSET_WEIGHT=0.35
REBALANCE_BAND=0.05
MIN_TRADE_USD=250
MAX_DAILY_LOSS=0.03
MAX_DRAWDOWN=0.08

