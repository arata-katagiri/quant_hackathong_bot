# Use the separate TEST credentials first. Never commit the real .env file.
ROOSTOO_API_KEY=
ROOSTOO_API_SECRET=
ROOSTOO_COMPET_API_KEY=
ROOSTOO_COMPET_API_SECRET=
CREDENTIAL_SET=testing

# Start in observation mode. Set to false only after reviewing dry-run logs.
DRY_RUN=true
LIVE_TRADING_ENABLED=false
PAIRS=BTC/USD,ETH/USD
POLL_SECONDS=300
DATA_DIR=data

# Strategy and safety limits
FAST_WINDOW=12
SLOW_WINDOW=48
MAX_ASSET_WEIGHT=0.35
REBALANCE_BAND=0.05
MIN_TRADE_USD=250
MAX_DAILY_LOSS=0.03
MAX_DRAWDOWN=0.08

# Research candidates only; none is approved for live trading.
STRATEGY=baseline
SIGNAL_SOURCE=binance
DECISION_EVERY_BARS=1
SIGNAL_BUFFER=0.005
FEE_RATE=0.001
SLIPPAGE_RATE=0.0005
CASH_RESERVE=0.01
MAX_SPREAD=0.005
MAX_QUOTE_AGE_SECONDS=30
MAX_SAMPLE_LAG_SECONDS=30

# Optional, used only by `python3 -m roostoo_bot.news --llm`.
# Never commit actual values or paste the key into chat.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=
